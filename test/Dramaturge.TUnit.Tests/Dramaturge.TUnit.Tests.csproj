  <ItemGroup>
    <ProjectReference Include="..\..\src\Dramaturge.TUnit\Dramaturge.TUnit.csproj" />
    <ProjectReference Include="..\Dramaturge.TestUtilities\Dramaturge.TestUtilities.csproj" />
  </ItemGroup>

</Project>
