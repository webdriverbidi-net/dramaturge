<Project Sdk="Microsoft.NET.Sdk">

  <!-- The code samples the Dramaturge articles and package READMEs show, compiled so that they cannot drift from the
       API. docs/tools/validate-doc-regions.sh checks that every sample an article or README shows is here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1998</NoWarn>

    <!-- The samples for each test framework name its namespaces themselves. -->
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WebDriverBiDi" Version="0.0.63" />
    <PackageReference Include="WebDriverBiDi.Extensions" Version="0.0.63" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Dramaturge/Dramaturge.csproj" />
    <ProjectReference Include="../../src/Dramaturge.Browsers/Dramaturge.Browsers.csproj" />
    <ProjectReference Include="../../src/Dramaturge.MSTest/Dramaturge.MSTest.csproj" />
    <ProjectReference Include="../../src/Dramaturge.NUnit/Dramaturge.NUnit.csproj" />
    <ProjectReference Include="../../src/Dramaturge.TUnit/Dramaturge.TUnit.csproj" />
    <ProjectReference Include="../../src/Dramaturge.Xunit/Dramaturge.Xunit.csproj" />
  </ItemGroup>

</Project>
